---
import Layout from '../../layouts/Layout.astro';
import { getRecordDetails, downloadFile } from '../../scripts/api.js';

export const prerender = false;

interface Record {
  id: string;
  event_time: string;
  source: string;
  full_content: string;
  location: string;
  privacy_importance: number;
  file_path?: string;
}

interface ApiError {
  message: string;
}

function isError(error: unknown): error is Error {
  return error instanceof Error;
}

const { id } = Astro.params;

let record: Record | null = null;
let error: unknown = null;

try {
  if (id) {
    console.log('Fetching record details for ID:', id);
    
    record = await getRecordDetails(id);
    
    console.log('Record details fetched successfully:', record);
  }
} catch (err) {
  console.error('Error fetching record details:', err);
  error = err;
}
---

<Layout title={error ? 'Error' : `Record ${id} Details`}>
  <div class="container mx-auto p-4">
    {error ? (
      <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative" role="alert">
        <strong class="font-bold">Error: </strong>
        <span class="block sm:inline">
          {isError(error) ? error.message : 'Unknown error occurred.'}
        </span>
      </div>
    ) : record ? (
      <div class="bg-white shadow-md rounded-lg p-6">
        <h1 class="text-2xl font-bold mb-4">Record Details</h1>
        <p><strong>Event Time:</strong> {record.event_time}</p>
        <p><strong>Source:</strong> {record.source}</p>
        <p><strong>Full Content:</strong> {record.full_content}</p>
        <p><strong>Location:</strong> {record.location}</p>
        <p><strong>Privacy Importance:</strong> {record.privacy_importance}</p>
        
        {record.file_path && (
          <button 
            id="download-file-btn" 
            data-file-key={record.file_path}
            class="mt-4 bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600"
          >
            Download File
          </button>
        )}
      </div>
    ) : (
      <div class="bg-yellow-100 border border-yellow-400 text-yellow-700 px-4 py-3 rounded relative">
        <strong class="font-bold">Notice: </strong>
        <span class="block sm:inline">No record found for the given ID.</span>
      </div>
    )}
  </div>

  {record?.file_path && (
    <script define:vars={{ fileKey: record.file_path }}>
      document.getElementById('download-file-btn')?.addEventListener('click', async () => {
        try {
          await downloadFile(fileKey);
        } catch (error) {
          console.error('Dsownload error:', error);
          alert(`Failed to download file: ${error instanceof Error ? error.message : 'Unknown error'}`);
        }
      });
    </script>
  )}
</Layout>