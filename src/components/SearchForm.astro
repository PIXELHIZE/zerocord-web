

<form id="search-form">
	<input type="text" name="keyword" placeholder="Search keyword">
	<select name="searchType">
	  <option value="content">Content</option>
	  <option value="source">Source</option>
	  <option value="location">Location</option>
	</select>
	<input type="datetime-local" name="startDate" placeholder="Start Date">
	<input type="datetime-local" name="endDate" placeholder="End Date">
	<select name="privacyImportance">
	  <option value="">Any Privacy Importance</option>
	  <option value="0">0</option>
	  <option value="1">1</option>
	  <option value="2">2</option>
	  <option value="3">3</option>
	  <option value="4">4</option>
	  <option value="5">5</option>
	</select>
	<button type="submit">Search</button>
  </form>
	
  <div id="search-results"></div> <!-- 이 부분 추가 -->
  <div id="record-details" style="display: none;"></div> <!-- 이 부분 추가 -->
	
<script>
  import { searchRecords, getRecordDetails, downloadFile } from '../scripts/api.js';

  document.getElementById('search-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement; // Type assertion to HTMLFormElement
    const formData = new FormData(form);
    const searchParams = Object.fromEntries(formData);

    try {
      const records = await searchRecords(searchParams);
      displaySearchResults(records);
    } catch (error) {
      alert('Search failed: ' + error.message);
    }
  });

  function displaySearchResults(records) {
    const resultsDiv = document.getElementById('search-results');
    if (records.length === 0) {
      resultsDiv.innerHTML = '<p>No records found.</p>';
      return;
    }

    const recordsList = records.map(record => `
      <li data-id="${record.id}">
        <strong>Event Time:</strong> ${record.event_time}<br>
        <strong>Source:</strong> ${record.source}<br>
        <strong>Summary:</strong> ${record.summary}<br>
        <strong>Location:</strong> ${record.location}<br>
        <strong>Privacy Importance:</strong> ${record.privacy_importance}<br>
        ${
          record.file_path
            ? `<button class="download-file" data-file-key="${record.file_path}">Download File</button>`
            : ''
        }
        <button class="view-details">View Details</button>
      </li>
    `).join('');

    resultsDiv.innerHTML = `<ul>${recordsList}</ul>`;
    attachEventListeners();
  }

  function attachEventListeners() {
  // Attach listeners for 'View Details' buttons
  document.querySelectorAll('.view-details').forEach(button => {
    button.addEventListener('click', (e) => {
      const recordId = (e.target as HTMLElement).closest('li').dataset.id;
      // Open the records page in a new tab
      window.open(`/records/${recordId}`, '_blank');
    });
  });
}


  async function viewDetails(e) {
    const recordId = (e.target as HTMLElement).closest('li').dataset.id;
    try {
      const record = await getRecordDetails(recordId);
      displayRecordDetails(record);
    } catch (error) {
      alert('Failed to fetch record details: ' + error.message);
    }
  }

  function displayRecordDetails(record) {
    const detailsDiv = document.getElementById('record-details');
    detailsDiv.style.display = 'block';
    detailsDiv.innerHTML = `
      <h3>Record Details</h3>
      <p><strong>Event Time:</strong> ${record.event_time}</p>
      <p><strong>Source:</strong> ${record.source}</p>
      <p><strong>Full Content:</strong> ${record.full_content}</p>
      <p><strong>File Path:</strong> ${
        record.file_path
          ? `<button class="download-file" data-file-key="${record.file_path}">Download File</button>`
          : 'N/A'
      }</p>
      <p><strong>Location:</strong> ${record.location}</p>
      <p><strong>Privacy Importance:</strong> ${record.privacy_importance}</p>
      <button onclick="hideDetails()">Close</button>
    `;

    // Attach download listener for the file in the details section
    const downloadButton = detailsDiv.querySelector('.download-file');
    if (downloadButton) {
      downloadButton.addEventListener('click', async (e) => {
        if (e.target instanceof HTMLElement && 'fileKey' in e.target.dataset) {
          const fileKey = e.target.dataset.fileKey;
          try {
            await downloadFile(fileKey);
          } catch (error) {
            alert('Failed to download file: ' + error.message);
          }
        }
      });
    }
  }

  function hideDetails() {
    const detailsDiv = document.getElementById('record-details');
    detailsDiv.style.display = 'none';
    detailsDiv.innerHTML = ''; // Clear the content
  }
</script>